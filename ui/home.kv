#:kivy 2.2.0
#:import dp kivy.metrics.dp
#:import BeanRoastAnim widgets.bean_roast_anim.BeanRoastAnim
#:import Clock kivy.clock.Clock

<HomeScreen>:

    BoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(26)

        canvas.before:
            Color:
                rgba: 0.07, 0.08, 0.10, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 1

        BoxLayout:
            size_hint_y: None
            height: dp(180)

            ClickLabel:
                text: "Sigma Coffee Roaster\nProfesionalty"
                font_size: "54sp"
                bold: True
                color: 0.92, 0.94, 0.98, 1
                halign: "center"
                valign: "middle"
                text_size: self.size
                on_release: root.go_live()

        FloatLayout:
            size_hint_y: None
            height: dp(260)

            BeanRoastAnim:
                id: roast_anim_home
                size_hint: None, None
                size: dp(340), dp(220)
                center_x: self.parent.center_x
                center_y: self.parent.center_y
                green_source: "assets/beans/bean_green_transparent.png"
                dark_source: "assets/beans/bean_dark_transparent.png"
                intensity: 0.8

        Widget:
            size_hint_y: 1