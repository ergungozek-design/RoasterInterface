#:kivy 2.2.0
#:import dp kivy.metrics.dp
#:import ButtonBehavior kivy.uix.behaviors.ButtonBehavior

#:set TITLE_COLOR 1,1,1,1
#:set VALUE_YELLOW 1.0, 0.85, 0.2, 1
#:set COLOR_CYAN 0.0, 0.75, 0.85, 1

# ---------------------------------------------------------
# Clickable rounded card (editable)
# ---------------------------------------------------------
<ClickCard@ButtonBehavior+BoxLayout>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.12, 0.13, 0.16, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(26), dp(26), dp(26), dp(26)]

# ---------------------------------------------------------
# Non-clickable rounded card (read-only)
# ---------------------------------------------------------
<ReadCard@BoxLayout>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.12, 0.13, 0.16, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(26), dp(26), dp(26), dp(26)]

# ---------------------------------------------------------
# Status button (unchanged behavior)
# 0=gray, 1=green, else=red
# ---------------------------------------------------------
<StatusBtn@Button>:
    status: 0
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    font_size: "22sp"
    bold: True
    size_hint_y: None
    height: dp(120)

    halign: "center"
    valign: "middle"
    text_size: self.size

    canvas.before:
        Color:
            rgba:
                (0.22, 0.22, 0.26, 1) if int(self.status or 0) == 0 else \
                (0.20, 0.65, 0.30, 1) if int(self.status or 0) == 1 else \
                (0.80, 0.22, 0.22, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(28), dp(28), dp(28), dp(28)]


# =========================================================
# MANUAL CONTROL SCREEN (AnchorLayout centered)
# =========================================================
<ManualControlScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(10)

        canvas.before:
            Color:
                rgba: 0.07, 0.08, 0.10, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # ---------------- Top header ----------------
        BoxLayout:
            size_hint_y: None
            height: dp(64)
            spacing: dp(12)

            DarkTab:
                text: "← Back"
                font_size: "25sp"
                bold: True
                on_release: root.go_back()

            DarkTab:
                text: "Manual Control"
                tab_key: "manual"
                font_size: "25sp"
                bold: True
                state: "down"

        # ---------------- 3x3 cards ----------------
        GridLayout:
            cols: 3
            spacing: dp(12)
            size_hint_y: None
            height: dp(3)*dp(140) + dp(2)*dp(12)

            # =====================================================
            # Row 1
            # =====================================================

            # SET VALUE (editable)
            ClickCard:
                on_release: root.open_edit("set")

                # TOP (title)
                Label:
                    text: "SET VALUE"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                # CENTER (value)
                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.set_text
                        font_size: "44sp"
                        bold: True
                        color: 0.98, 0.25, 0.25, 1

                # BOTTOM (footer)
                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            # Exhaust Temp (read-only)
            ReadCard:
                Label:
                    text: "Exhaust Temp"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.exhaust_temp_text
                        font_size: "44sp"
                        bold: True
                        color: VALUE_YELLOW #0.98, 0.25, 0.25, 1

                # empty footer (same height)
                Label:
                    text: " "
                    size_hint_y: None
                    height: dp(20)

            # Drum Temp (read-only)
            ReadCard:
                Label:
                    text: "Drum Temp"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.drum_temp_text
                        font_size: "44sp"
                        bold: True
                        color: VALUE_YELLOW #0.98, 0.25, 0.25, 1

                # empty footer (same height)
                Label:
                    text: " "
                    size_hint_y: None
                    height: dp(20)

            # =====================================================
            # Row 2
            # =====================================================

            # Burner %
            ClickCard:
                on_release: root.open_edit("burner_pct")

                Label:
                    text: "Burner %"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.burner_pct_text
                        font_size: "44sp"
                        bold: True
                        color: 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            # Exhaust %
            ClickCard:
                on_release: root.open_edit("exhaust_pct")

                Label:
                    text: "Exhaust %"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.exhaust_pct_text
                        font_size: "44sp"
                        bold: True
                        color: 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            # Drum %
            ClickCard:
                on_release: root.open_edit("drum_pct")

                Label:
                    text: "Drum %"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.drum_pct_text
                        font_size: "44sp"
                        bold: True
                        color: 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            # =====================================================
            # Row 3
            # =====================================================

            # Cooling Time
            ClickCard:
                on_release: root.open_edit("cooling_time")

                Label:
                    text: "Cooling Time"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.cooling_time_text
                        font_size: "44sp"
                        bold: True
                        color: COLOR_CYAN # 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size


            # Mixer ON
            ClickCard:
                on_release: root.open_edit("mixer_on")

                Label:
                    text: "Mixer ON"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.mixer_on_text
                        font_size: "44sp"
                        bold: True
                        color: COLOR_CYAN # 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

            # Mixer OFF
            ClickCard:
                on_release: root.open_edit("mixer_off")

                Label:
                    text: "Mixer OFF"
                    font_size: "20sp"
                    bold: True
                    color: TITLE_COLOR #0.15, 0.85, 0.95, 1
                    size_hint_y: None
                    height: dp(28)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    Label:
                        text: root.mixer_off_text
                        font_size: "44sp"
                        bold: True
                        color: COLOR_CYAN # 0.98, 0.25, 0.25, 1

                Label:
                    text: "Tap to edit"
                    font_size: "14sp"
                    color: 0.70, 0.74, 0.80, 1
                    size_hint_y: None
                    height: dp(20)
                    halign: "center"
                    valign: "middle"
                    text_size: self.size



        # ---------------- Bottom controls (unchanged) ----------------
        BoxLayout:
            orientation: "vertical"
            padding: dp(14)
            spacing: dp(16)

            Widget:

            Label:
                text: root.last_msg
                font_size: "14sp"
                color: 0.70, 0.74, 0.80, 1
                size_hint_y: None
                height: dp(42)
                halign: "center"
                valign: "middle"
                text_size: self.size

            BoxLayout:
                orientation: "horizontal"
                spacing: dp(16)
                size_hint_y: None
                height: dp(120)

                StatusBtn:
                    text: "Drum\n" + ("STOP" if int(root.drum_status) == 1 else "START")
                    status: root.drum_status
                    on_release: root.toggle_drum()

                StatusBtn:
                    text: "Burner\n" + ("STOP" if int(root.burner_status) == 1 else "START")
                    status: root.burner_status
                    on_release: root.toggle_burner()

                StatusBtn:
                    text: "Mixer\n" + ("STOP" if int(root.mixer_status) == 1 else "START")
                    status: root.mixer_status
                    on_release: root.toggle_mixer()

                StatusBtn:
                    text: "Cooler\n" + ("STOP" if int(root.cooler_status) == 1 else "START")
                    status: root.cooler_status
                    on_release: root.toggle_cooler()

                StatusBtn:
                    text: "Destoner\n" + ("STOP" if int(root.destoner_status) == 1 else "START")
                    status: root.destoner_status
                    on_release: root.toggle_destoner()


                #StatusBtn:
                #    text: "Cooling\n" + ("STOP" if int(root.cooling_status) == 1 else "START")
                #    status: root.cooling_status
                #    on_release: root.toggle_cooling()


                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(6)
                    size_hint_x: None
                    width: dp(180)   # istersen dp(240) / dp(280) ayarlarsın

                    Label:
                        text: root.cooling_start_delay_text + " sec"
                        font_size: "22sp"
                        bold: True
                        color: 1.0, 0.85, 0.2, 1      # sarı
                        size_hint_y: None
                        height: dp(30)
                        halign: "center"
                        valign: "middle"
                        text_size: self.size


                    StatusBtn:
                        text: "Cooling\n" + ("STOP" if int(root.cooling_status) == 1 else "START")
                        status: root.cooling_status
                        on_release: root.toggle_cooling()


                BoxLayout:
                    orientation: "vertical"
                    spacing: dp(6)
                    size_hint_x: None
                    width: dp(180)   # istersen dp(240) / dp(280) ayarlarsın


                    StatusBtn:
                        text: "Shut Down\n" + ("STOP" if int(root.cooling_status) == 1 else "START")
                        status: root.shutdown_status
                        on_release: root.toggle_shutdown()
